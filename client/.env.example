# Base URL for API calls. Leave as /api to use the Vite dev proxy (recommended —
# works on localhost, phones on your LAN and tunnelled demo URLs).
# Set to http://localhost:5000/api to call the Express server directly.
VITE_API_URL=/api
# When true, the consumer flow keeps working with bundled demo data if the API is unreachable.
VITE_DEMO_MODE=true
