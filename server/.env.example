# Port the Express API listens on
PORT=5000
# MongoDB connection string (local or Atlas). Only used when DEMO_MODE=false
MONGO_URI=mongodb://localhost:27017/solarmitra
# Secret used to sign admin JWTs — CHANGE THIS for any shared deployment
JWT_SECRET=change_this_secret
# true = in-memory seeded demo data (no MongoDB needed). false = use MongoDB
DEMO_MODE=true
# Allowed browser origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173
